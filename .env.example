# Wilco configuration. Copy to .env (bootstrap.sh does this) and fill in.
# Lines starting with WILCO_HARNESS_ and COMPOSE_FILE are for maintainers
# running the confidence board; leave them out otherwise.

# --- required ---------------------------------------------------------------
# The app's public origin and the message-body origin. BOTH must be https
# and they must be DIFFERENT hosts: session cookies are Secure, the CSRF check
# compares the Origin header to WILCO_BASE_URL, and message HTML is rendered
# only on the body origin, sandboxed. See INSTALL.md for the proxy setup.
WILCO_BASE_URL=https://mail.example.com
WILCO_BODY_BASE_URL=https://mailbody.example.com

# Written by bootstrap.sh (or scripts/set-password.ts). Note the DOUBLED
# dollars: docker compose interpolates `$`, and `$$` is its escape.
WILCO_PASSWORD_HASH=

# --- optional ---------------------------------------------------------------
# Where the container publishes on the host. Keep the bind on loopback (or a
# LAN/tailnet address) and put a TLS reverse proxy in front of it.
WILCO_BIND=127.0.0.1
WILCO_HOST_PORT=8794
# Path to the master key file created by bootstrap.sh (0600, NOT in git).
WILCO_MASTER_KEY_PATH=./secrets/master-key
# Image to run. `wilco:local` builds from this checkout; a published image
# (ghcr.io/gig3m/wilco:<tag>) skips the client build.
WILCO_IMAGE=wilco:local
TZ=UTC

# --- maintainers only -------------------------------------------------------
#COMPOSE_FILE=docker-compose.yml:docker-compose.harness.yml
#WILCO_HARNESS_BASE_URL=https://wilcotest.example.com
#WILCO_HARNESS_BODY_BASE_URL=https://wilcotestbody.example.com
#WILCO_HARNESS_HOST_PORT=8797
#WILCO_HARNESS_MASTER_KEY_PATH=./secrets/master-key-harness
# The board reads its login password as WILCO_HARNESS_PASSWORD. If your keys
# store files it under another name, name that key here.
#WILCO_HARNESS_PASSWORD_KEY=WILCO_HARNESS_PASSWORD
